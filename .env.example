# YearMedia — copy to .env in the relevant service. Placeholders only.
# No real keys are committed or required to run in demo/local mode.

# --- apps/api ---
PORT=4000
JWT_SECRET=change-me-to-a-long-random-secret
GEMINI_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AI_SERVICE_URL=http://localhost:8000

# --- apps/web (build-time) ---
VITE_API_URL=http://127.0.0.1:4000
# Leave VITE_API_URL empty for demo mode (no backend).

# --- services/ai ---
AI_PORT=8000
GEMINI_API_KEY=
BIREFNET_MODEL=ZhengPeng7/BiRefNet
MODEL_CACHE=./models
