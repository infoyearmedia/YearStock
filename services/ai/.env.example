# YearMedia AI service — copy to .env and fill in. Never commit a real .env.
# Gemini API key for /metadata (get one at https://aistudio.google.com/apikey).
# If unset, /metadata returns 503 gemini_not_configured — never fake output.
GEMINI_API_KEY=

# Port the AI service listens on (apps/api proxies to this).
AI_PORT=8000

# BiRefNet model id (Hugging Face) used by /remove-bg.
BIREFNET_MODEL=ZhengPeng7/BiRefNet

# Directory where downloaded model weights are cached.
# Download with: python3 scripts/download_models.py
MODEL_CACHE=./models

# Optional: override the Gemini model used for metadata.
GEMINI_MODEL=gemini-2.0-flash
